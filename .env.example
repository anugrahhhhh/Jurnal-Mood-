# Salin menjadi .env lalu sesuaikan.
# PostgreSQL dari Laragon: user postgres tanpa password, port 5432.
DATABASE_URL=postgres://postgres@localhost:5432/moodjournal?sslmode=disable

# Alamat server. 127.0.0.1 = hanya bisa dibuka dari komputer ini.
ADDR=127.0.0.1:8080

# development atau production (production mengaktifkan HSTS dan cache statis).
APP_ENV=development

# Pendaftaran: open (terbuka, dibatasi 5 pendaftaran per IP per jam) atau
# invite (wajib kode undangan; buat dengan: go run ./cmd/server invite).
REGISTRATION=open

# File kontak bantuan krisis. Jika belum ada, dipakai config/crisis.example.yaml.
CRISIS_FILE=config/crisis.yaml

# Pengingat harian Web Push (opsional). Kosongkan untuk menonaktifkan.
# Buat kunci: go run ./cmd/server vapid   (atau: wsl -d Ubuntu -- bash scripts/dev.sh vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Identitas pengelola (ditampilkan di halaman Privasi & Syarat). Wajib diisi sebelum dipakai orang lain.
OPERATOR_NAME=
OPERATOR_CONTACT=
# Usia minimum pengguna (bawaan 18).
MIN_AGE=18

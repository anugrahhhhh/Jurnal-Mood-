# Salin menjadi deploy/.env.prod lalu isi. File .env.prod jangan di-commit.

# Domain yang sudah diarahkan (DNS A/AAAA record) ke server ini.
DOMAIN=jurnal.contoh.id

# Password database: panjang dan acak, mis. hasil `openssl rand -base64 32`.
# Hindari karakter @ : / ? # karena dipakai di dalam URL koneksi.
DB_PASSWORD=ganti-dengan-password-acak

# open (terbuka, dibatasi 5 pendaftaran per IP per jam) atau invite (wajib kode undangan).
REGISTRATION=open

# Berapa hari backup harian disimpan.
BACKUP_KEEP_DAYS=14

# Pengingat harian (opsional). Buat dengan:
#   docker compose run --rm --no-deps app vapid
# Kunci privat jangan dibagikan. SUBJECT: mailto:email-pengelola atau URL https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
